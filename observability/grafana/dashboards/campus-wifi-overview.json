{
  "id": null,
  "uid": "campus-wifi-overview",
  "title": "Campus Wi-Fi — Overview",
  "description": "Мониторинг Windows 11 через мобильную точку доступа.",
  "tags": [
    "production-sre-lab",
    "campus-wifi",
    "windows"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Windows Exporter — доступность",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"campus-wifi-windows\"}",
          "legendFormat": "Exporter",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Wi-Fi — входящая скорость",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(windows_net_bytes_received_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])*8)",
          "legendFormat": "RX",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Wi-Fi — исходящая скорость",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(windows_net_bytes_sent_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])*8)",
          "legendFormat": "TX",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Wi-Fi — сетевой трафик",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(windows_net_bytes_received_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])*8",
          "legendFormat": "Получено",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "rate(windows_net_bytes_sent_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])*8",
          "legendFormat": "Отправлено",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Wi-Fi — ошибки передачи пакетов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(windows_net_packets_received_errors_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])",
          "legendFormat": "Ошибки RX",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "increase(windows_net_packets_outbound_errors_total{job=\"campus-wifi-windows\",nic=~\".*Wi-Fi.*\"}[5m])",
          "legendFormat": "Ошибки TX",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Wi-Fi — состояние подключения",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(campus_wifi_connected{job=\"campus-wifi-windows\"}) and on(job,instance) (time() - campus_wifi_collection_timestamp_seconds{job=\"campus-wifi-windows\"} < 120)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ОТКЛЮЧЕНО"
                },
                "1": {
                  "text": "ПОДКЛЮЧЕНО"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Wi-Fi — уровень сигнала",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 6,
        "y": 23,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(campus_wifi_signal_percent{job=\"campus-wifi-windows\"}) and on(job,instance) (time() - campus_wifi_collection_timestamp_seconds{job=\"campus-wifi-windows\"} < 120)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "Wi-Fi — RSSI (dBm)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(campus_wifi_rssi_dbm{job=\"campus-wifi-windows\"}) and on(job,instance) (time() - campus_wifi_collection_timestamp_seconds{job=\"campus-wifi-windows\"} < 120)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": -70
              },
              {
                "color": "green",
                "value": -55
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Wi-Fi — возраст данных",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - campus_wifi_collection_timestamp_seconds{job=\"campus-wifi-windows\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Wi-Fi — скорость соединения (Мбит/с)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "campus_wifi_receive_link_mbps{job=\"campus-wifi-windows\"}",
          "legendFormat": "Приём"
        },
        {
          "refId": "B",
          "expr": "campus_wifi_transmit_link_mbps{job=\"campus-wifi-windows\"}",
          "legendFormat": "Передача"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
