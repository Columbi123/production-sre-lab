    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU utilisation by VM (%)",
      "description": "Five-minute average non-idle CPU share of each VM.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sre-lab"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-sre-lab"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (server) (rate(node_cpu_seconds_total{job=~\"node-control|node-app\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{server}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
